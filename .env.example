# NeuroAnalyst — Environment Variables
# Ushbu faylni .env deb nusxalang va qiymatlarni o'zgartiring:
# cp .env.example .env

# ─────────────────────────────────────────────────────
# XAVFSIZLIK (SECURITY)
# ─────────────────────────────────────────────────────
# Kamida 32 ta tasodifiy belgi: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-very-long-random-secret-key-at-least-32-chars

# AES-256 uchun aynan 32 bayt (64 hex belgi):
# python -c "import secrets; print(secrets.token_hex(32))"
AES_MASTER_KEY=change-me-to-64-hex-chars-aes256-master-encryption-key-here

# JWT token muddati (daqiqalarda)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=24

# ─────────────────────────────────────────────────────
# MA'LUMOTLAR BAZASI (PostgreSQL)
# ─────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=neuroanalyst_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ─────────────────────────────────────────────────────
# MODEL YO'LLARI
# ─────────────────────────────────────────────────────
MODEL_PATH=ml_pipeline/real_output/checkpoints/eeg_model_best.pt
ONNX_PATH=ml_pipeline/real_output/checkpoints/eeg_model.onnx
MODEL_CONFIG_PATH=ml_pipeline/real_output/real_config.json

# Agar demo model ishlatilsa (real output yo'q bo'lsa):
# MODEL_PATH=ml_pipeline/demo_output/checkpoints/eeg_model_best.pt
# MODEL_CONFIG_PATH=ml_pipeline/demo_output/demo_config.json
# ONNX_PATH=ml_pipeline/demo_output/checkpoints/eeg_model.onnx

# ─────────────────────────────────────────────────────
# SERVER SOZLAMALARI
# ─────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Streamlit dan FastAPI ga ulanish uchun
BACKEND_URL=http://localhost:8000

# ─────────────────────────────────────────────────────
# SHIFRLANISH SOZLAMALARI
# ─────────────────────────────────────────────────────
# EEG fayllarini diskda shifrlash (true/false)
ENCRYPT_EEG_FILES=true
ENCRYPTED_DATA_DIR=data/encrypted_eeg
